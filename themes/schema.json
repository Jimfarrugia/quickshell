{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qe.local/schema/theme-v1.json",
  "title": "QE theme v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "variant", "palette", "tokens"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "variant": { "enum": ["dark", "light"] },
    "palette": {
      "type": "object",
      "description": "Raw palette names are theme-specific; semantic roles belong in tokens.",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$" }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "on_background", "surface", "on_surface", "surface_variant", "on_surface_variant", "surface_panel", "on_surface_panel", "surface_tooltip", "on_surface_tooltip", "surface_hover", "surface_pressed", "primary", "on_primary", "primary_container", "on_primary_container", "secondary", "on_secondary", "outline", "outline_variant", "focus_ring", "on_surface_disabled", "on_surface_placeholder", "link", "highlight", "on_highlight", "success", "charging", "warning", "error", "shadow", "scrim"],
      "properties": {
        "background": { "$ref": "#/$defs/colorOrReference" },
        "on_background": { "$ref": "#/$defs/colorOrReference" },
        "surface": { "$ref": "#/$defs/colorOrReference" },
        "on_surface": { "$ref": "#/$defs/colorOrReference" },
        "surface_variant": { "$ref": "#/$defs/colorOrReference" },
        "on_surface_variant": { "$ref": "#/$defs/colorOrReference" },
        "surface_panel": { "$ref": "#/$defs/colorOrReference" },
        "on_surface_panel": { "$ref": "#/$defs/colorOrReference" },
        "surface_tooltip": { "$ref": "#/$defs/colorOrReference" },
        "on_surface_tooltip": { "$ref": "#/$defs/colorOrReference" },
        "surface_hover": { "$ref": "#/$defs/colorOrReference" },
        "surface_pressed": { "$ref": "#/$defs/colorOrReference" },
        "primary": { "$ref": "#/$defs/colorOrReference" },
        "on_primary": { "$ref": "#/$defs/colorOrReference" },
        "primary_container": { "$ref": "#/$defs/colorOrReference" },
        "on_primary_container": { "$ref": "#/$defs/colorOrReference" },
        "secondary": { "$ref": "#/$defs/colorOrReference" },
        "on_secondary": { "$ref": "#/$defs/colorOrReference" },
        "outline": { "$ref": "#/$defs/colorOrReference" },
        "outline_variant": { "$ref": "#/$defs/colorOrReference" },
        "focus_ring": { "$ref": "#/$defs/colorOrReference" },
        "on_surface_disabled": { "$ref": "#/$defs/colorOrReference" },
        "on_surface_placeholder": { "$ref": "#/$defs/colorOrReference" },
        "link": { "$ref": "#/$defs/colorOrReference" },
        "highlight": { "$ref": "#/$defs/colorOrReference" },
        "on_highlight": { "$ref": "#/$defs/colorOrReference" },
        "success": { "$ref": "#/$defs/colorOrReference" },
        "charging": { "$ref": "#/$defs/colorOrReference" },
        "warning": { "$ref": "#/$defs/colorOrReference" },
        "error": { "$ref": "#/$defs/colorOrReference" },
        "shadow": { "$ref": "#/$defs/colorOrReference" },
        "scrim": { "$ref": "#/$defs/colorOrReference" }
      }
    }
  },
  "$defs": {
    "colorOrReference": {
      "type": "string",
      "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|\\{(palette|tokens)\\.[A-Za-z][A-Za-z0-9]*\\})$"
    }
  }
}
