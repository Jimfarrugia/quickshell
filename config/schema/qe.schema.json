{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qe.local/schema/config-v1.json",
  "title": "QE configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "defaultTheme": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$", "default": "poimandres" },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean", "default": true } }
    },
    "bar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "edge": { "enum": ["top", "bottom"], "default": "top" },
        "exclusive": { "type": "boolean", "default": true },
        "height": { "type": "integer", "minimum": 16, "maximum": 128, "default": 26 },
        "trayHostEnabled": { "type": "boolean", "default": false },
        "moduleSpacing": { "type": "integer", "minimum": 0, "maximum": 64, "default": 8 }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "showSeconds": { "type": "boolean", "default": false },
        "format24h": { "type": "boolean", "default": false }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000, "default": 5000 },
        "termGraceMs": { "type": "integer", "minimum": 0, "maximum": 30000, "default": 1000 },
        "maxOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576, "default": 32768 }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontFamily": { "type": "string", "minLength": 1, "default": "Inter" },
        "monospaceFontFamily": { "type": "string", "minLength": 1, "default": "JetBrainsMono Nerd Font" },
        "iconFontFamily": { "type": "string", "minLength": 1, "default": "Material Symbols Rounded" },
        "fontSize": { "type": "number", "minimum": 8, "maximum": 48, "default": 14 },
        "spacing": { "type": "number", "minimum": 0, "maximum": 64, "default": 8 },
        "radius": { "type": "number", "minimum": 0, "maximum": 64, "default": 10 },
        "borderWidth": { "type": "number", "minimum": 0, "maximum": 8, "default": 1 },
        "opacity": { "type": "number", "minimum": 0.1, "maximum": 1, "default": 1 },
        "shadows": { "type": "boolean", "default": true },
        "animations": { "type": "boolean", "default": true }
      }
    }
  }
}
