{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qe.local/schema/defaults-v1.json",
  "title": "QE authored defaults manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultTheme"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "defaultTheme": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" }
  }
}
